# Base de datos PostgreSQL (Supabase). Usa la cadena "Transaction pooler" (puerto 6543)
# y agrega ?schema=aldore para que las tablas queden separadas de Castorly.
# Local: postgresql://postgres:postgres@localhost:5432/aldore?schema=aldore
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aldore?schema=aldore"

# Secreto para firmar las sesiones del panel admin (mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-123456"

# Código para crear el primer administrador desde /admin/login (base vacía).
SETUP_CODE="cambia-este-codigo"

# Usuario administrador inicial para `npm run db:seed` (opcional en Node)
ADMIN_EMAIL="admin@aldore.co"
ADMIN_PASSWORD="CambiaEsta123!"

# URL pública del sitio (para SEO y sitemap)
SITE_URL="https://aldore.co"
